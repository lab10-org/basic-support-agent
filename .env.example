# Requerido: todos los modelos van por OpenRouter
OPENROUTER_API_KEY=

# Opcional (cualquier modelo de https://openrouter.ai/models con prefijo openrouter/)
# FAST_MODEL=openrouter/anthropic/claude-haiku-5.5   (redacta título y resumen del caso)
# JEV_MODEL=typesafe/jev-1.14                         (triage y Ticketizer)
# TRIAGE_UMBRAL=0.7                                   (noul desde el que se marca una regla)
# TICKET_CONFIANZA_MIN=0.5                            (confianza mínima para actuar sobre el caso)
# OLIVIA_MODEL=openrouter/anthropic/claude-sonnet-5.5
# SLACK_WEBHOOK_URL=
# PORT=3000
